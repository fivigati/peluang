<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escape Room: The Digital Vault</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --neon-cyan: #00f2ff;
            --neon-purple: #9d00ff;
            --bg-deep: #020617;
        }

        body {
            background-color: var(--bg-deep);
            color: #e2e8f0;
            font-family: 'Rajdhani', sans-serif;
            overflow: hidden;
        }

        .font-cyber { font-family: 'Orbitron', sans-serif; }

        /* Scrollbar Styling */
        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--neon-cyan);
            border-radius: 10px;
            box-shadow: 0 0 10px var(--neon-cyan);
        }

        /* Cyberpunk Background Effect */
        .grid-bg {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: 
                linear-gradient(rgba(0, 242, 255, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 242, 255, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: -1;
            perspective: 500px;
        }

        .neon-border {
            border: 1px solid var(--neon-cyan);
            box-shadow: 0 0 15px rgba(0, 242, 255, 0.3), inset 0 0 15px rgba(0, 242, 255, 0.1);
        }

        .neon-text {
            text-shadow: 0 0 10px var(--neon-cyan);
        }

        .btn-action {
            background: rgba(0, 242, 255, 0.1);
            border: 2px solid var(--neon-cyan);
            transition: all 0.3s;
            clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
        }

        .btn-action:hover {
            background: var(--neon-cyan);
            color: black;
            box-shadow: 0 0 25px var(--neon-cyan);
        }

        .screen { display: none; height: 100vh; width: 100vw; }
        .screen.active { display: flex; animation: fadeIn 0.5s ease-in-out; }

        @keyframes fadeIn { from { opacity: 0; transform: scale(1.05); } to { opacity: 1; transform: scale(1); } }

        .avatar-card {
            transition: all 0.3s;
            cursor: pointer;
            filter: grayscale(0.8);
        }

        .avatar-card.selected {
            filter: grayscale(0);
            border-color: var(--neon-cyan);
            background: rgba(0, 242, 255, 0.2);
            transform: scale(1.1);
        }

        .door {
            transition: all 0.5s;
            perspective: 1000px;
        }

        .door-inner {
            transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }

        .door:hover:not(.locked) .door-inner {
            transform: rotateY(-20deg);
        }

        .locked { filter: grayscale(1) brightness(0.5); cursor: not-allowed; }

        #ticker {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 280px;
            background: rgba(0,0,0,0.8);
            border-left: 4px solid var(--neon-purple);
            padding: 10px;
            font-size: 0.85rem;
            z-index: 100;
        }
    </style>
</head>
<body>

