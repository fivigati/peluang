        ];

        const room3_bank = [
            {q: "Sebuah dadu dilempar 60 kali. Frekuensi harapan muncul mata dadu 3 adalah ....", o: ["5","10","15","20"], a: 1},
            {q: "Sebuah koin dilempar 40 kali. Frekuensi harapan muncul gambar adalah ....", o: ["10","15","20","25"], a: 2},
            {q: "Sebuah dadu dilempar 72 kali. Frekuensi harapan muncul bilangan genap adalah ....", o: ["24","30","36","42"], a: 2},
            {q: "Dua buah koin dilempar bersama-sama sebanyak 80 kali. Frekuensi harapan muncul dua angka adalah ....", o: ["10","20","30","40"], a: 1},
            {q: "Sebuah kartu bernomor 1 sampai 10 diambil acak sebanyak 50 kali. Frekuensi harapan terambil bilangan prima adalah ....", o: ["15","20","25","30"], a: 1},
            {q: "Sebuah spinner memiliki 4 warna sama besar. Spinner diputar 120 kali. Frekuensi harapan muncul warna merah adalah ....", o: ["20","30","40","50"], a: 1},
            {q: "Sebuah dadu dilempar 90 kali. Frekuensi harapan muncul bilangan kurang dari 3 adalah ....", o: ["15","20","30","45"], a: 2},
            {q: "Dua buah dadu dilempar bersama-sama sebanyak 72 kali. Frekuensi harapan jumlah mata dadu 7 adalah ....", o: ["6","12","18","24"], a: 1},
            {q: "Sebuah koin dilempar 100 kali. Frekuensi harapan muncul angka adalah ....", o: ["25","40","50","75"], a: 2},
            {q: "Sebuah kartu bernomor 1 sampai 20 diambil acak sebanyak 80 kali. Frekuensi harapan terambil kelipatan 5 adalah ....", o: ["12","16","20","24"], a: 1},
            {q: "Peluang muncul mata dadu prima adalah 1/2. Jika sebuah dadu dilempar 70 kali, frekuensi harapan tidak muncul mata dadu prima adalah ....", o: ["25","30","35","40"], a: 2},
            {q: "Peluang seorang pemain sepak bola gagal mencetak gol penalti adalah 0,2. Jika melakukan 60 tendangan, frekuensi harapan berhasil mencetak gol adalah ....", o: ["42","45","48","50"], a: 2},
            {q: "Peluang seorang siswa datang terlambat adalah 0,1. Jika ada 250 hari sekolah, frekuensi harapan siswa datang tepat waktu adalah ....", o: ["200","210","225","240"], a: 2},
            {q: "Peluang turun hujan hari ini adalah 0,25. Selama 40 hari, frekuensi harapan hari tidak hujan adalah ....", o: ["20","25","30","35"], a: 2},
            {q: "Peluang sebuah mesin menghasilkan barang cacat adalah 0,08. Jika mesin menghasilkan 500 barang, frekuensi harapan barang tidak cacat adalah ....", o: ["420","440","460","480"], a: 3},
            {q: "Peluang seorang pemain basket berhasil memasukkan bola adalah 0,7. Jika melakukan 50 tembakan, frekuensi harapan tembakan gagal adalah ....", o: ["10","15","20","25"], a: 1},
            {q: "Peluang muncul bilangan genap saat dadu dilempar adalah 1/2. Jika dadu dilempar 90 kali, frekuensi harapan tidak muncul bilangan genap adalah ....", o: ["30","40","45","50"], a: 2},
            {q: "Sebuah toko mencatat peluang pelanggan membeli roti adalah 0,4. Jika ada 200 pelanggan, frekuensi harapan pelanggan membeli roti adalah ....", o: ["40","60","80","100"], a: 2},
            {q: "Peluang seorang printer rusak 0,04. Jika digunakan 300 kali, frekuensi harapan printer tidak rusak adalah ....", o: ["276","282","288","294"], a: 2},
            {q: "Peluang bus datang tepat waktu 0,9. Dalam 150 perjalanan, frekuensi harapan bus terlambat adalah ....", o: ["10","12","15","20"], a: 2}
        ];

        let player = { name: "", avatar: 0, unlocked: [1] };
        let currentRoom = 0;
        let questions = [];
        let index = 0;
        let mistakes = [];
        let firstPassScore = 0;
        let initialQuestionsCount = 0;
        let isRevisiting = false;

        const dummyPlayers = ["Aris_Bot", "Santi_Cyber", "Rudi_99", "Nina_X", "Eko_Vault", "Maya_Bit", "Zaki_N0de"];
        setInterval(() => {
            const ticker = document.getElementById('ticker-content');
            const randomPlayer = dummyPlayers[Math.floor(Math.random() * dummyPlayers.length)];
            const actions = ["baru saja memasuki Ruang 1", "sedang mengerjakan Ruang 2", "berhasil membuka Ruang 3", "mendapatkan skor 90%!", "mengulang Ruang 1"];
            ticker.style.opacity = 0;
            setTimeout(() => {
                ticker.innerText = `${randomPlayer} ${actions[Math.floor(Math.random() * actions.length)]}`;
                ticker.style.opacity = 1;
            }, 300);
        }, 6000);

        function selectAvatar(idx, el) {
            document.querySelectorAll('.avatar-card').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            player.avatar = idx;
        }

        function enterLobby() {
            const nameInput = document.getElementById('playerName').value;
            if (!nameInput) return alert("Masukkan ID kamu!");
            player.name = nameInput;
            document.getElementById('lobbyWelcome').innerText = `Siap mendekripsi, ${player.name}? Pilih ruangan di bawah.`;
            document.getElementById('loginScreen').classList.remove('active');
            document.getElementById('lobbyScreen').classList.add('active');
            updateDoors();
        }

        function updateDoors() {
            if (player.unlocked.includes(2)) {
                document.getElementById('door2').classList.remove('locked');
                document.getElementById('door2').querySelector('.mt-auto').innerText = "TERBUKA";
                document.getElementById('door2').querySelector('i').className = "fa-solid fa-chart-pie text-cyan-400 mb-4";
            }
            if (player.unlocked.includes(3)) {
                document.getElementById('door3').classList.remove('locked');
                document.getElementById('door3').querySelector('.mt-auto').innerText = "TERBUKA";
                document.getElementById('door3').querySelector('i').className = "fa-solid fa-bolt text-cyan-400 mb-4";
            }
        }

        function startRoom(num) {
            if (!player.unlocked.includes(num)) return;
            currentRoom = num;
            index = 0;
            firstPassScore = 0;
            mistakes = [];
            isRevisiting = false;

            if (num === 1) questions = room1_bank.sort(() => 0.5 - Math.random()).slice(0, 15);
            else if (num === 2) questions = [...room2_partA.sort(() => 0.5-Math.random()).slice(0,10), ...room2_partB.sort(() => 0.5-Math.random()).slice(0,10)];
            else questions = room3_bank.sort(() => 0.5 - Math.random()).slice(0, 15);

            initialQuestionsCount = questions.length;
            document.getElementById('playerAvatarImg').src = document.querySelectorAll('.avatar-card img')[player.avatar].src;
            document.getElementById('displayPlayerName').innerText = player.name;
            document.getElementById('roomLabel').innerText = `ROOM 0${num} // DECRYPTING`;
            document.getElementById('gameLog').innerHTML = `<p>> Inisialisasi Vault Ruangan ${num}...</p><p>> Dekripsi dimulai.</p>`;

            document.getElementById('lobbyScreen').classList.remove('active');
            document.getElementById('gameScreen').classList.add('active');
            showQuestion();
        }

        function showQuestion() {
            const q = questions[index];
            document.getElementById('questionText').innerText = q.q;
            document.getElementById('progressText').innerText = `${String(index + 1).padStart(2, '0')} / ${questions.length}`;
            document.getElementById('progressBar').style.width = `${((index + 1) / questions.length) * 100}%`;
            
            const optionsEl = document.getElementById('optionsGrid');
            optionsEl.innerHTML = "";
            q.o.forEach((opt, i) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left bg-slate-800/50 border border-slate-700 p-3 md:p-4 rounded-xl hover:bg-slate-700 transition-all text-base md:text-lg flex items-center gap-4";
                btn.innerHTML = `<span class="bg-slate-700 w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-lg text-sm font-bold text-cyan-400">${String.fromCharCode(65+i)}</span> <span class="flex-grow">${opt}</span>`;
                btn.onclick = () => handleAnswer(i, btn);
                optionsEl.appendChild(btn);
            });
            if (isRevisiting) addLog(`MEMPERBAIKI ERROR...`);
        }

        function handleAnswer(choice, btn) {
            const q = questions[index];
            const allBtns = document.querySelectorAll('#optionsGrid button');
            allBtns.forEach(b => b.disabled = true);

            if (choice === q.a) {
                btn.classList.add('border-green-500', 'bg-green-500/20');
                if (!isRevisiting) firstPassScore++;
                addLog(`HASIL: BERHASIL`);
            } else {
                btn.classList.add('border-red-500', 'bg-red-500/20');
                mistakes.push(q);
                addLog(`HASIL: GAGAL (MENGULANG NANTI)`);
            }

            setTimeout(() => {
                index++;
                if (index < questions.length) showQuestion();
                else if (mistakes.length > 0) {
                    isRevisiting = true;
                    questions = [...mistakes];
                    mistakes = [];
                    index = 0;
                    alert("Ada beberapa modul yang gagal didekripsi. Sistem akan mengulang modul yang bermasalah.");
                    showQuestion();
                } else showSummary();
            }, 1000);
        }

        function addLog(msg) {
            const logEl = document.getElementById('gameLog');
            const p = document.createElement('p');
            p.innerText = `> ${msg}`;
            logEl.prepend(p);
            if (logEl.children.length > 5) logEl.removeChild(logEl.lastChild);
        }

        function showSummary() {
            const accuracy = Math.round((firstPassScore / initialQuestionsCount) * 100);
            const isLulus = accuracy >= 75;
            document.getElementById('sumAvatar').src = document.querySelectorAll('.avatar-card img')[player.avatar].src;
            document.getElementById('sumName').innerText = player.name;
            document.getElementById('sumRoom').innerText = `ROOM 0${currentRoom}: ${currentRoom === 1 ? 'KONSEP PELUANG' : currentRoom === 2 ? 'NILAI & KOMPLEMEN' : 'FREKUENSI HARAPAN'}`;
            document.getElementById('sumAccuracy').innerText = `${accuracy}%`;
            document.getElementById('sumTotal').innerText = `${initialQuestionsCount}/${initialQuestionsCount}`;
            const badge = document.getElementById('sumBadge');
            badge.innerText = isLulus ? "LULUS" : "GAGAL";
            badge.className = `absolute -bottom-2 -right-2 font-bold px-3 py-1 rounded text-xs shadow-lg ${isLulus ? 'bg-green-500 text-black' : 'bg-red-500 text-white'}`;
            document.getElementById('sumMessage').innerText = isLulus ? "Sistem Vault terbuka! Kamu telah menguasai probabilitas." : "Akurasi rendah. Kamu harus mencoba ruangan ini lagi.";
            if (isLulus && currentRoom < 3 && !player.unlocked.includes(currentRoom + 1)) player.unlocked.push(currentRoom + 1);
            document.getElementById('gameScreen').classList.remove('active');
            document.getElementById('summaryScreen').classList.add('active');
        }

        function finishAndLobby() {
            document.getElementById('summaryScreen').classList.remove('active');
            document.getElementById('lobbyScreen').classList.add('active');
            updateDoors();
        }
    </script>
</body>
</html>
